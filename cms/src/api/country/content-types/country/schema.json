{
  "kind": "collectionType",
  "collectionName": "countries",
  "info": {
    "singularName": "country",
    "pluralName": "countries",
    "displayName": "Country",
    "description": "Country available in the quote wizard"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "code": { "type": "string", "required": true, "unique": true, "regex": "^[A-Z]{2}$" },
    "icon": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "order": { "type": "integer", "required": true, "min": 1 },
    "active": { "type": "boolean", "required": true, "default": true },
    "legalAge": { "type": "integer", "required": true, "min": 0, "default": 18 }
  }
}
